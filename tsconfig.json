{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "#tcp": ["./src/platform/tcp.node.ts"],
      "#aead": ["./src/platform/aead.node.ts"],
      "@azora-db/client": ["./src/index.ts"],
      "@azora-db/units": ["./packages/units/src/index.ts"],
      "@azora-db/units/tools": ["./packages/units/src/tools.ts"]
    }
  },
  "include": ["src", "test", "bench", "scripts", "examples/*.ts", "examples/units/*.ts", "examples/units/units/**/*.ts", "vitest.config.ts"]
}
